NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DEV_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/relay?replicaSet=rs0&directConnection=true
MONGODB_DB=relay
FIREBASE_PROJECT_ID=your-project
FIREBASE_API_KEY=your-public-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_APP_ID=your-public-app-id
# Server only: service account JSON on one line (or GOOGLE_APPLICATION_CREDENTIALS path).
FIREBASE_ADMIN_CREDENTIALS=
CACHE_ENABLED=false
REDIS_URL=
# Private S3-compatible bucket: AWS S3, Cloudflare R2, or another S3 provider.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
